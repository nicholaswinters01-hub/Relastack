// Platform database schema.
//
// RULE: every schema change ships as a tracked migration. Never edit a
// migration that has already been applied to a shared environment.
//
//   Phase 4 — Role, Permission, Invitation
//   Phase 5 — Module, OrganizationModule
//   Phase 6 — Plan, Subscription, Entitlement

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED

  @@map("user_status")
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED

  @@map("organization_status")
}

/// Legacy membership role, superseded by MembershipRole in Phase 4.
///
/// Retained because the Phase 4 migration derives the new scoped assignments
/// from it, and because dropping a column in the same migration that reads it
/// is how data gets lost. A later migration removes it once nothing reads it.
/// Application code must use the permission service, never this column.
enum OrganizationRole {
  OWNER
  MEMBER

  @@map("organization_role")
}

/// A person who can sign in. Distinct from an Employee record (Phase 9) —
/// an employee may exist without a login, and a login may exist without an
/// employee record.
///
/// NOT tenant-owned: a user is a global identity that may hold membership in
/// more than one organization. Tenant scoping lives on the membership.
model User {
  id String @id @default(uuid()) @db.Uuid

  /// Citext so that "Nick@example.com" and "nick@example.com" cannot become
  /// two separate accounts. Enforced by the database, not by application code
  /// remembering to lowercase.
  email        String     @unique @db.Citext
  passwordHash String     @map("password_hash")
  firstName    String?    @map("first_name")
  lastName     String?    @map("last_name")
  status       UserStatus @default(ACTIVE)

  lastLoginAt DateTime? @map("last_login_at")

  /// Consecutive failed sign-in attempts. Reset to zero on success.
  ///
  /// Rate limiting alone is per-IP, which a credential-stuffing attacker
  /// defeats simply by rotating addresses — the attack that actually happens
  /// in the wild. Counting per account closes that.
  failedLoginAttempts Int @default(0) @map("failed_login_attempts")

  /// Set when the failure threshold is crossed. Sign-in is refused until it
  /// passes, with the same generic message as any other failure so that
  /// probing cannot distinguish a locked account from a wrong password.
  lockedUntil DateTime? @map("locked_until")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  memberships         OrganizationMembership[]

  platformStaff PlatformStaff?

  @@map("users")
}

/// An authenticated browser session.
///
/// Only the SHA-256 hash of the token is stored. The token itself exists in
/// exactly two places: the user's cookie, and the response that created it.
/// A stolen database dump therefore grants no sessions.
///
/// Deliberately carries no organization: the caller's organization is resolved
/// from membership on every request, so removing someone from an organization
/// takes effect immediately rather than when their session eventually expires.
model Session {
  id String @id @default(uuid()) @db.Uuid

  userId    String @map("user_id") @db.Uuid
  tokenHash String @unique @map("token_hash")

  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  lastUsedAt DateTime  @default(now()) @map("last_used_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  /// Captured for audit and for showing users their active sessions.
  /// Never used for authorization — both are trivially spoofed.
  ipAddress String? @map("ip_address")
  userAgent String? @map("user_agent")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// A "forgot password" link, sent by email.
///
/// Like a session, only the hash of the token is stored: a copy of this table
/// must not be a set of working links. Short-lived, single-use, and every
/// earlier unused link for the person dies when a new one is issued.
model PasswordResetToken {
  id String @id @default(uuid()) @db.Uuid

  userId    String @map("user_id") @db.Uuid
  tokenHash String @unique @map("token_hash")

  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  /// Recorded for audit. Never used to decide anything.
  requestedIp String? @map("requested_ip")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("password_reset_tokens")
}

/// A customer business. THE tenant boundary — the unit of isolation.
///
/// Protected by row-level security: see the migration that adds
/// `organization_isolation`. Every row is visible only when the transaction's
/// `app.current_organization_id` matches.
model Organization {
  id String @id @default(uuid()) @db.Uuid

  name   String
  /// URL-safe identifier. Unique across the platform, so it is derived from
  /// the name with a random suffix rather than taken from user input directly.
  slug   String             @unique
  status OrganizationStatus @default(ACTIVE)

  /// The next customer account number to hand out. Only ever goes up.
  nextCustomerNumber Int @default(1001) @map("next_customer_number")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships  OrganizationMembership[]
  locations    Location[]
  roles        Role[]
  invitations  Invitation[]
  modules      OrganizationModule[]
  subscription Subscription?

  customers              Customer[]
  tags                   Tag[]
  tasks                  Task[]
  jobs                   Job[]
  jobSeries              JobSeries[]
  events                 DomainEvent[]
  notifications          Notification[]
  customFieldDefinitions CustomFieldDefinition[]
  staffNotes             StaffNote[]
  billingPayments        BillingPayment[]
  billingCredits         BillingCredit[]
  memberGroups           MemberGroup[]
  supportRequests        SupportRequest[]

  @@map("organizations")
}

/// Joins a global user to an organization.
///
/// The join table (rather than a column on User) exists so that a single
/// person can eventually belong to several organizations — a consultant, or an
/// owner of two businesses. Retrofitting that after launch would mean migrating
/// live authentication, which is the worst migration there is.
model OrganizationMembership {
  id String @id @default(uuid()) @db.Uuid

  userId         String           @map("user_id") @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  role           OrganizationRole @default(MEMBER)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  locationMemberships LocationMembership[]
  roleAssignments     MembershipRole[]

  ownedCustomers          Customer[]
  authoredNotes           CustomerNote[]
  assignedTasks           Task[]                   @relation("TaskAssignee")
  createdTasks            Task[]                   @relation("TaskCreator")
  jobAssignments          JobAssignment[]          @relation("JobAssignee")
  createdJobs             Job[]                    @relation("JobCreator")
  seriesCrew              JobSeriesAssignment[]    @relation("SeriesAssignee")
  createdSeries           JobSeries[]              @relation("SeriesCreator")
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  groupMemberships        MemberGroupMember[]

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
  @@map("organization_memberships")
}

enum LocationStatus {
  ACTIVE
  INACTIVE

  @@map("location_status")
}

/// A physical place of business.
///
/// THE BILLING UNIT. The commercial model prices by location rather than by
/// user, so Phase 6 counts rows here. Nothing about this table may make user
/// count a billing input.
///
/// Also the first entity that is *owned by* a tenant rather than *being* one,
/// so it is the template every business module follows: a non-nullable
/// organization_id, an RLS policy keyed on it, and a service that takes tenant
/// context as its first argument.
model Location {
  id String @id @default(uuid()) @db.Uuid

  organizationId String @map("organization_id") @db.Uuid

  name String
  /// Unique within the organization, not globally — two businesses may each
  /// have a "Downtown" without conflicting.
  slug String

  addressLine1 String? @map("address_line1")
  addressLine2 String? @map("address_line2")
  city         String?
  region       String?
  postalCode   String? @map("postal_code")
  country      String?

  phone String?
  email String?

  /// Appointment times are meaningless without it (Phase 9).
  timezone String         @default("UTC")
  status   LocationStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization        Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships         LocationMembership[]
  roleAssignments     MembershipRoleLocation[]
  invitationLocations InvitationLocation[]

  customers       Customer[]
  sharedCustomers CustomerLocation[]
  tasks           Task[]
  jobs            Job[]
  jobSeries       JobSeries[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("locations")
}

/// Assigns a member of an organization to one of its locations.
///
/// Links to OrganizationMembership rather than directly to User: location
/// access only means anything inside an organization. Removing someone from
/// the company therefore removes them from every location automatically,
/// through one cascade rather than a cleanup routine that can be forgotten.
model LocationMembership {
  id String @id @default(uuid()) @db.Uuid

  membershipId String @map("membership_id") @db.Uuid
  locationId   String @map("location_id") @db.Uuid

  /// Denormalised from the location so the RLS policy is a direct column
  /// comparison rather than a subquery. Policies are evaluated on every row of
  /// every query; a join there is a tax on everything the platform does.
  organizationId String @map("organization_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  membership OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  location   Location               @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([membershipId, locationId])
  @@index([locationId])
  @@index([organizationId])
  @@map("location_memberships")
}

/// How far a role assignment reaches.
///
/// The heart of the permission model. A permission is never a plain yes/no —
/// it is a permission PLUS a scope, because a Location Manager manages
/// *specific* locations. A flat role cannot express that, and expressing it in
/// application code instead would mean re-deriving it in every module.
enum RoleScope {
  /// Applies across the whole organization.
  ORGANIZATION
  /// Applies only at explicitly linked locations.
  LOCATION

  @@map("role_scope")
}

/// A named bundle of permissions.
///
/// System roles are seeded and shared by every organization (organizationId
/// null). Custom, organization-defined roles are a higher-tier subscription
/// feature: the column exists so Phase 5 can gate creating them without a
/// schema change, but nothing writes it yet.
model Role {
  id String @id @default(uuid()) @db.Uuid

  /// Null for system roles. Set for organization-defined roles (gated by
  /// entitlement from Phase 5).
  organizationId String? @map("organization_id") @db.Uuid

  /// Stable machine identifier — 'org_admin', 'location_manager', 'employee'.
  /// Code refers to this, never to the display name.
  key         String
  name        String
  description String?

  /// The scope this role is normally assigned at. An assignment may still
  /// narrow it, but never widen it beyond this.
  defaultScope RoleScope @default(ORGANIZATION) @map("default_scope")

  /// System roles cannot be edited or deleted by customers.
  isSystem Boolean @default(false) @map("is_system")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions  RolePermission[]
  assignments  MembershipRole[]
  invitations  Invitation[]     @relation("InvitationRole")

  @@unique([organizationId, key])
  @@index([organizationId])
  @@map("roles")
}

/// A capability that can be granted.
///
/// Seeded from a constant in code and keyed by string ('customer.write'), so a
/// module can declare the permissions it needs without a migration. Not
/// tenant-owned: the catalogue is identical for every organization.
model Permission {
  key         String @id
  module      String
  description String

  roles RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  roleId        String @map("role_id") @db.Uuid
  permissionKey String @map("permission_key")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@map("role_permissions")
}

/// Grants a role to an organization member, at a scope.
///
/// Replaces the placeholder OrganizationMembership.role from Phase 2. A member
/// may hold several: organization-wide Employee plus Location Manager at two
/// branches is a normal arrangement.
model MembershipRole {
  id String @id @default(uuid()) @db.Uuid

  membershipId String    @map("membership_id") @db.Uuid
  roleId       String    @map("role_id") @db.Uuid
  scope        RoleScope @default(ORGANIZATION)

  /// Denormalised for the RLS policy, as on location_memberships. Policies run
  /// against every row of every query; a subquery there taxes everything.
  organizationId String @map("organization_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  membership OrganizationMembership   @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role                     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  locations  MembershipRoleLocation[]

  @@unique([membershipId, roleId, scope])
  @@index([organizationId])
  @@index([membershipId])
  @@map("membership_roles")
}

/// Which locations a LOCATION-scoped role assignment applies to.
///
/// Empty for ORGANIZATION-scoped assignments. This table is what makes
/// "manages Downtown and Northside, but not Warehouse" expressible.
model MembershipRoleLocation {
  membershipRoleId String @map("membership_role_id") @db.Uuid
  locationId       String @map("location_id") @db.Uuid
  organizationId   String @map("organization_id") @db.Uuid

  membershipRole MembershipRole @relation(fields: [membershipRoleId], references: [id], onDelete: Cascade)
  location       Location       @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@id([membershipRoleId, locationId])
  @@index([organizationId])
  @@index([locationId])
  @@map("membership_role_locations")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED

  @@map("invitation_status")
}

/// An invitation for someone to join an organization.
///
/// This is how employees get in: self-registration always creates a new
/// business, so there is no path by which someone joins an existing one
/// uninvited.
///
/// The token is treated exactly like a session token — 256 bits of randomness,
/// only its SHA-256 hash stored, single use, and expiring. An invitation link
/// grants access to a company's data, so it deserves the same care as a
/// password reset.
model Invitation {
  id String @id @default(uuid()) @db.Uuid

  organizationId String @map("organization_id") @db.Uuid
  email          String @db.Citext
  tokenHash      String @unique @map("token_hash")

  roleId String    @map("role_id") @db.Uuid
  scope  RoleScope @default(ORGANIZATION)

  status    InvitationStatus @default(PENDING)
  expiresAt DateTime         @map("expires_at")

  invitedByMembershipId String? @map("invited_by_membership_id") @db.Uuid

  acceptedAt DateTime? @map("accepted_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role                 @relation("InvitationRole", fields: [roleId], references: [id], onDelete: Cascade)
  locations    InvitationLocation[]

  // Deliberately no unique constraint on (organization, email). A partial
  // unique index over PENDING rows is what this wants, and Prisma cannot
  // express one; a full constraint would forbid a second revoked invitation
  // to the same address. InvitationsService supersedes any prior pending
  // invitation instead, which is also the behaviour a user expects from
  // "invite again".
  @@index([organizationId, email])
  @@index([organizationId])
  @@index([expiresAt])
  @@map("invitations")
}

/// Locations a LOCATION-scoped invitation will grant on acceptance.
model InvitationLocation {
  invitationId   String @map("invitation_id") @db.Uuid
  locationId     String @map("location_id") @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  location   Location   @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@id([invitationId, locationId])
  @@index([organizationId])
  @@map("invitation_locations")
}

/// Mirror of the code-defined module registry.
///
/// The registry in `@platform/shared` is the source of truth — modules ship
/// with the build. This table exists so per-organization state can reference a
/// module by foreign key, and so an operator can query what exists without
/// reading the source.
model Module {
  key         String  @id
  name        String
  description String
  isCore      Boolean @default(false) @map("is_core")

  /// Module keys that must be enabled first. Denormalised from the registry.
  dependencies String[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organizations OrganizationModule[]
  plans         PlanModule[]
  addOns        SubscriptionAddOn[]

  @@map("modules")
}

/// Whether one organization may use one module.
///
/// A row's absence means "not enabled" — the default is off for everything
/// except core, so a new module shipped in a later release does not silently
/// become available to every existing customer.
///
/// Phase 6 replaces manual toggling with plan-derived entitlement. Nothing
/// outside this table's own service should care which it was, which is the
/// point of resolving entitlement behind one interface.
model OrganizationModule {
  organizationId String @map("organization_id") @db.Uuid
  moduleKey      String @map("module_key")

  enabled Boolean @default(true)

  enabledAt  DateTime? @map("enabled_at")
  disabledAt DateTime? @map("disabled_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  module       Module       @relation(fields: [moduleKey], references: [key], onDelete: Cascade)

  @@id([organizationId, moduleKey])
  @@index([organizationId])
  @@map("organization_modules")
}

/// Where a subscription stands commercially.
///
/// Drives access in three bands. The middle one is the grace period: a failed
/// payment must not lock a landscaping company out mid-job, so PAST_DUE keeps
/// full access while the customer is chased. Only after grace does access
/// narrow to read-only — never to nothing, because a customer who cannot reach
/// their own data cannot decide to come back.
enum SubscriptionStatus {
  /// Evaluating. Full access.
  TRIALING
  /// Paid and current. Full access.
  ACTIVE
  /// Payment failed, grace period running. Full access.
  PAST_DUE
  /// Grace expired. READ-ONLY.
  SUSPENDED
  /// Ended by the customer. READ-ONLY, so they can still export.
  CANCELLED

  @@map("subscription_status")
}

/// A commercial package.
///
/// Plans are DATA, not code. Repackaging, repricing, or introducing a new tier
/// is an insert here — business logic never reads a price and never branches on
/// a plan name (see docs/adr/0003).
model Plan {
  key         String @id
  name        String
  description String

  /// Monthly price in the smallest currency unit, charged regardless of size.
  basePriceCents Int @default(0) @map("base_price_cents")

  /// Monthly price per location. THE pricing model: customers are billed by
  /// location, never by user count.
  perLocationPriceCents Int @default(0) @map("per_location_price_cents")

  /// Locations included before per-location charges apply.
  includedLocations Int @default(1) @map("included_locations")

  /// Hard ceiling on locations. Null means no limit.
  maxLocations Int? @map("max_locations")

  /// Unlimited by design. The platform is never priced per user.
  maxUsers Int? @map("max_users")

  /// Offered to new customers. Retired plans stay for existing subscribers.
  isPublic Boolean @default(true) @map("is_public")

  /// Days of full access after a failed payment, before read-only.
  gracePeriodDays Int @default(14) @map("grace_period_days")

  trialDays Int @default(14) @map("trial_days")

  /// Months charged for a year paid up front: 10 means two months free.
  annualBillingMonths Int @default(12) @map("annual_billing_months")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  modules       PlanModule[]
  subscriptions Subscription[]

  @@map("plans")
}

/// Modules included in a plan at no extra charge.
model PlanModule {
  planKey   String @map("plan_key")
  moduleKey String @map("module_key")

  plan   Plan   @relation(fields: [planKey], references: [key], onDelete: Cascade)
  module Module @relation(fields: [moduleKey], references: [key], onDelete: Cascade)

  @@id([planKey, moduleKey])
  @@map("plan_modules")
}

/// What one organization currently pays for.
///
/// Exactly one per organization. Changing plan updates this row rather than
/// creating another, so there is never ambiguity about which subscription is
/// in force.
model Subscription {
  id String @id @default(uuid()) @db.Uuid

  organizationId String @unique @map("organization_id") @db.Uuid
  planKey        String @map("plan_key")

  status SubscriptionStatus @default(TRIALING)

  /// Current billing period. Phase 18 syncs these from the payment provider.
  periodStartsAt DateTime  @map("period_starts_at")
  periodEndsAt   DateTime  @map("period_ends_at")
  trialEndsAt    DateTime? @map("trial_ends_at")

  /// When full access stops and read-only begins. Set on payment failure.
  graceEndsAt DateTime? @map("grace_ends_at")

  cancelledAt DateTime? @map("cancelled_at")

  /// Opaque identifier from the payment provider. Null while billing is
  /// mocked; Phase 18 fills it. Deliberately provider-agnostic — nothing here
  /// mentions Stripe.
  providerCustomerId     String? @map("provider_customer_id")
  providerSubscriptionId String? @map("provider_subscription_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan                @relation(fields: [planKey], references: [key])
  addOns       SubscriptionAddOn[]

  @@index([status])
  @@index([graceEndsAt])
  @@map("subscriptions")
}

/// A module purchased beyond what the plan includes.
model SubscriptionAddOn {
  subscriptionId String @map("subscription_id") @db.Uuid
  moduleKey      String @map("module_key")

  /// Monthly price at the time of purchase, so a later price change does not
  /// silently reprice an existing customer.
  priceCents Int @default(0) @map("price_cents")

  organizationId String @map("organization_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  module       Module       @relation(fields: [moduleKey], references: [key], onDelete: Cascade)

  @@id([subscriptionId, moduleKey])
  @@index([organizationId])
  @@map("subscription_add_ons")
}

// ---------------------------------------------------------------------------
// CRM (Phase 7)
// ---------------------------------------------------------------------------

/// Where a customer sits in their lifecycle.
///
/// One record moves through these rather than a Lead table graduating into a
/// Customer table. Converting is a status change, so every note, contact and
/// tag written while they were a lead survives it, and "how many leads
/// converted" is one query rather than a reconciliation across two tables.
enum CustomerStage {
  LEAD
  ACTIVE
  INACTIVE
  ARCHIVED
}

/// A household or a business. Determines which name fields are meaningful.
enum CustomerType {
  PERSON
  COMPANY
}

model Customer {
  id String @id @default(uuid()) @db.Uuid

  organizationId String @map("organization_id") @db.Uuid

  /// The account number people say on the phone: #1001, #1002, … per business.
  /// Filled in by the database on insert (see the add_customer_account_numbers
  /// migration), so every way of creating a customer gets one. Never reused.
  /// Nullable only to Prisma: a CHECK constraint makes it required.
  accountNumber Int? @map("account_number")

  stage CustomerStage @default(LEAD)
  type  CustomerType  @default(PERSON)

  /// Denormalised so lists and search do not have to branch on type. Derived
  /// on write from the company name or the person name.
  displayName String  @map("display_name")
  companyName String? @map("company_name")
  firstName   String? @map("first_name")
  lastName    String? @map("last_name")

  email String?
  phone String?

  addressLine1 String? @map("address_line1")
  addressLine2 String? @map("address_line2")
  city         String?
  region       String?
  postalCode   String? @map("postal_code")
  country      String?

  /// Free text, not an enum: every business describes its own lead sources,
  /// and forcing them into ours would make the field useless.
  source String?

  /// The branch that primarily serves this customer. Nullable because a
  /// single-location business has no meaningful answer, and because a lead
  /// often arrives before anyone has decided who handles it.
  ///
  /// Visibility follows this. A customer with no location is visible only to
  /// organization-wide roles — the same rule Phase 3 applies to an unassigned
  /// location, and for the same reason.
  locationId String? @map("location_id") @db.Uuid

  /// Who is responsible. An OrganizationMembership, not a User, so removing
  /// someone from the company cleans this up through one cascade.
  ownerMembershipId String? @map("owner_membership_id") @db.Uuid

  /// Values for this organization's custom field definitions.
  ///
  /// JSONB rather than an entity-attribute-value table: values are always
  /// read as part of the customer and never queried across customers, and EAV
  /// would turn every read into a join whose row count varies by tenant.
  /// Validation happens at the boundary, built from the definitions.
  customFields Json @default("{}") @map("custom_fields")

  /// When the stage last moved to ACTIVE. Stored rather than derived, because
  /// a customer can lapse and come back.
  convertedAt     DateTime? @map("converted_at")
  lastContactedAt DateTime? @map("last_contacted_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization    Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location        Location?               @relation(fields: [locationId], references: [id], onDelete: SetNull)
  ownerMembership OrganizationMembership? @relation(fields: [ownerMembershipId], references: [id], onDelete: SetNull)

  contacts        Contact[]
  notes           CustomerNote[]
  tasks           Task[]
  jobs            Job[]
  tags            CustomerTag[]
  sharedLocations CustomerLocation[]
  jobSeries       JobSeries[]

  @@unique([organizationId, accountNumber])
  @@index([organizationId, stage])
  @@index([organizationId, locationId])
  @@index([organizationId, displayName])
  @@index([organizationId, ownerMembershipId])
  @@map("customers")
}

/// Shares a customer with a location beyond their primary one.
///
/// Gated by the Shared Customers module, which higher plans include. A
/// commercial client served by three branches is a bigger-business problem, so
/// the capability is priced accordingly — but the table is always present, and
/// rows already here keep working if a plan is downgraded. Withdrawing sight
/// of data someone can already see is the one thing a lapse must never do.
model CustomerLocation {
  customerId String @map("customer_id") @db.Uuid
  locationId String @map("location_id") @db.Uuid

  organizationId String @map("organization_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@id([customerId, locationId])
  @@index([organizationId])
  @@index([locationId])
  @@map("customer_locations")
}

/// A person at a customer.
///
/// Separate from Customer because a COMPANY has several, and because the
/// person who signs the contract is often not the person who answers the door.
model Contact {
  id String @id @default(uuid()) @db.Uuid

  organizationId String @map("organization_id") @db.Uuid
  customerId     String @map("customer_id") @db.Uuid

  firstName String  @map("first_name")
  lastName  String? @map("last_name")
  title     String?

  email String?
  phone String?

  /// At most one per customer, enforced in the service rather than by a
  /// constraint: a partial unique index cannot express "at most one true"
  /// without also forbidding a second false.
  isPrimary Boolean @default(false) @map("is_primary")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([customerId])
  @@map("contacts")
}

/// A dated note against a customer.
model CustomerNote {
  id String @id @default(uuid()) @db.Uuid

  organizationId String @map("organization_id") @db.Uuid
  customerId     String @map("customer_id") @db.Uuid

  /// Nullable so a note survives the author leaving the company. The record of
  /// what was said to a customer outlives any one employee.
  authorMembershipId String? @map("author_membership_id") @db.Uuid

  body String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  customer Customer                @relation(fields: [customerId], references: [id], onDelete: Cascade)
  author   OrganizationMembership? @relation(fields: [authorMembershipId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([customerId, createdAt])
  @@map("customer_notes")
}

/// A label defined once per organization and applied to many customers.
///
/// A table rather than a string array on the customer, so correcting a
/// misspelled tag is one update instead of a scan, and so a tag can carry a
/// colour without every row repeating it.
model Tag {
  id String @id @default(uuid()) @db.Uuid

  organizationId String @map("organization_id") @db.Uuid

  name  String
  /// A palette name, not a hex value — the interface owns what the colours
  /// actually are, and a stored hex would outlive the design that chose it.
  color String @default("neutral")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customers    CustomerTag[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("tags")
}

model CustomerTag {
  customerId String @map("customer_id") @db.Uuid
  tagId      String @map("tag_id") @db.Uuid

  organizationId String @map("organization_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([customerId, tagId])
  @@index([organizationId])
  @@map("customer_tags")
}

/// What a custom field may hold.
enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  BOOLEAN
  SELECT
}

/// Which record a custom field is attached to.
///
/// An enum with one member today. Phase 8 adds tasks and Phase 9 scheduling,
/// and both will want the same mechanism — a column here is cheaper now than a
/// second parallel table later.
enum CustomFieldEntity {
  CUSTOMER
}

/// One organization's definition of a field the platform did not ship.
///
/// Definitions are rows; values live in the record's JSONB column. This is
/// what "prefer configuration over customer-specific branches" means in
/// practice: a business needing a "Gate code" field is data, not a fork.
model CustomFieldDefinition {
  id String @id @default(uuid()) @db.Uuid

  organizationId String @map("organization_id") @db.Uuid

  entity CustomFieldEntity @default(CUSTOMER)

  /// Stable machine key. Renaming the label must not orphan the values, so the
  /// key is fixed once created.
  key   String
  label String

  type CustomFieldType @default(TEXT)

  /// Choices for a SELECT field, ignored otherwise.
  options Json @default("[]")

  isRequired Boolean @default(false) @map("is_required")
  position   Int     @default(0)

  /// Retired rather than deleted. The values stay in place, so re-adding the
  /// field brings the history back instead of a column of blanks.
  archivedAt DateTime? @map("archived_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, entity, key])
  @@index([organizationId, entity])
  @@map("custom_field_definitions")
}

// ---------------------------------------------------------------------------
// Tasks (Phase 8)
// ---------------------------------------------------------------------------

/// Where a piece of work has got to.
///
/// BLOCKED is a first-class state rather than a flag, because "waiting on the
/// customer" is the most common reason work stalls in a service business and
/// it is not the same as nobody having started.
enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELLED

  @@map("task_status")
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT

  @@map("task_priority")
}

/// Something that needs doing.
///
/// Part of core, not a module: a platform that cannot record "ring Mrs Patel
/// back on Thursday" looks unfinished on any plan, and Scheduling and
/// Automation are both built on top of this.
///
/// Deliberately NOT a CRM sub-record. It can hang off a customer or stand
/// alone, and Phase 9 jobs will attach to the same table through a second
/// nullable reference rather than a parallel one. That is what "workflow
/// infrastructure" means here — the shape other modules attach to.
model Task {
  id String @id @default(uuid()) @db.Uuid

  organizationId String @map("organization_id") @db.Uuid

  title       String
  description String?

  status   TaskStatus   @default(TODO)
  priority TaskPriority @default(NORMAL)

  dueAt       DateTime? @map("due_at")
  /// Set when status first becomes DONE, and left alone afterwards so
  /// reopening and completing again keeps the original date.
  completedAt DateTime? @map("completed_at")

  /// Which branch the work belongs to. Nullable for company-wide work, which
  /// is then visible only to organization-wide roles — the same rule Phase 3
  /// applies to an unassigned location and Phase 7 to an unassigned customer.
  locationId String? @map("location_id") @db.Uuid

  /// Who is doing it. Whoever is assigned can always see and complete the
  /// task, even at a location they do not otherwise work at: someone chose to
  /// give them this specific piece of work, and a task the assignee cannot
  /// find is a silent failure.
  assigneeMembershipId String? @map("assignee_membership_id") @db.Uuid

  /// Who asked for it. Nullable so a task survives its author leaving.
  createdByMembershipId String? @map("created_by_membership_id") @db.Uuid

  /// What it is about. Null for standalone work.
  customerId String? @map("customer_id") @db.Uuid

  /// Which booked job it belongs to, if any. The second nullable reference
  /// promised when tasks were built: a job checklist is tasks, not a parallel
  /// table with its own permissions to get wrong.
  jobId String? @map("job_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     Location?               @relation(fields: [locationId], references: [id], onDelete: SetNull)
  assignee     OrganizationMembership? @relation("TaskAssignee", fields: [assigneeMembershipId], references: [id], onDelete: SetNull)
  createdBy    OrganizationMembership? @relation("TaskCreator", fields: [createdByMembershipId], references: [id], onDelete: SetNull)
  /// Cascade: a task about a customer is meaningless once the customer is
  /// permanently deleted, and that delete already requires customer.delete.
  customer     Customer?               @relation(fields: [customerId], references: [id], onDelete: Cascade)
  job          Job?                    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([organizationId, assigneeMembershipId])
  @@index([organizationId, dueAt])
  @@index([organizationId, locationId])
  @@index([customerId])
  @@index([jobId])
  @@map("tasks")
}

// ---------------------------------------------------------------------------
// Scheduling (Phase 9)
// ---------------------------------------------------------------------------

/// Where a booked piece of work has got to.
///
/// NO_SHOW is separate from CANCELLED because they mean different things to a
/// business: one is a customer who changed their mind in advance, the other is
/// a crew that drove there for nothing. Collapsing them loses the number that
/// decides whether to start taking deposits.
enum JobStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW

  @@map("job_status")
}

/// Work booked into a slot in the calendar.
///
/// Gated by the Scheduling module, which depends on CRM.
///
/// Times are stored as instants and rendered in the branch's timezone. The
/// `timezone` column on Location has been carrying a note since Phase 3 saying
/// appointment times are meaningless without it; this is the phase that
/// collects on that.
model Job {
  id String @id @default(uuid()) @db.Uuid

  organizationId String @map("organization_id") @db.Uuid

  title       String
  description String?

  status JobStatus @default(SCHEDULED)

  /// The booked window. A CHECK constraint refuses an end before a start,
  /// because a negative-length appointment corrupts every calendar and
  /// conflict query that reads it afterwards.
  startsAt DateTime @map("starts_at")
  endsAt   DateTime @map("ends_at")

  /// Set when the status first becomes COMPLETED, and left alone afterwards.
  completedAt DateTime? @map("completed_at")

  /// Which branch runs the work. Nullable for company-wide jobs, which are
  /// then visible only to organization-wide roles — the rule locations,
  /// customers and tasks all already follow.
  locationId String? @map("location_id") @db.Uuid

  /// Who the work is for. Nullable, because a business also schedules its own
  /// van servicing and yard days.
  customerId String? @map("customer_id") @db.Uuid

  /// WHERE the work happens.
  ///
  /// Deliberately its own address rather than the customer's. A landscaping
  /// firm mows a rental property while the customer lives elsewhere, and a
  /// commercial client has several sites. Falling back to the customer address
  /// sends the crew to a billing address, which is the classic field-service
  /// failure.
  addressLine1 String? @map("address_line1")
  addressLine2 String? @map("address_line2")
  city         String?
  region       String?
  postalCode   String? @map("postal_code")
  country      String?

  createdByMembershipId String? @map("created_by_membership_id") @db.Uuid

  /// The series this visit came from, if any.
  seriesId String? @map("series_id") @db.Uuid

  /// Which occurrence it is, as a calendar day. Lets regeneration find what
  /// already exists without matching on times that may have been moved.
  seriesOccurrenceOn DateTime? @map("series_occurrence_on") @db.Date

  /// Set the moment somebody edits this visit individually.
  ///
  /// Changing the series afterwards leaves it alone. Somebody deliberately
  /// moved this one to Thursday, and silently dragging it back on the next
  /// rule change is how people stop trusting a calendar.
  detachedFromSeries Boolean @default(false) @map("detached_from_series")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     Location?               @relation(fields: [locationId], references: [id], onDelete: SetNull)
  customer     Customer?               @relation(fields: [customerId], references: [id], onDelete: Cascade)
  series       JobSeries?              @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  createdBy    OrganizationMembership? @relation("JobCreator", fields: [createdByMembershipId], references: [id], onDelete: SetNull)

  assignments JobAssignment[]
  tasks       Task[]

  @@index([organizationId, startsAt])
  @@index([organizationId, status])
  @@index([organizationId, locationId])
  @@index([customerId])
  @@index([seriesId, seriesOccurrenceOn])
  @@map("jobs")
}

/// Who is going.
///
/// A join table rather than a column, because a crew is the normal case: two
/// people to a job, three on a big one. Tasks have a single assignee and jobs
/// do not, which is the main structural difference between them.
model JobAssignment {
  jobId        String @map("job_id") @db.Uuid
  membershipId String @map("membership_id") @db.Uuid

  organizationId String @map("organization_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  job    Job                    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  member OrganizationMembership @relation("JobAssignee", fields: [membershipId], references: [id], onDelete: Cascade)

  @@id([jobId, membershipId])
  @@index([organizationId])
  /// The index the conflict check runs on: everything this person is booked
  /// for, so an overlapping window is a range scan rather than a table scan.
  @@index([membershipId])
  @@map("job_assignments")
}

// ---------------------------------------------------------------------------
// Recurring jobs (Phase 9b)
// ---------------------------------------------------------------------------

/// How often a series repeats.
///
/// Deliberately not full RFC 5545. "Every second Tuesday" and "the first of
/// the month" cover what a service business actually sells; supporting
/// "the last weekday before Easter" would be machinery nobody asked for.
enum RecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY

  @@map("recurrence_frequency")
}

/// The template a run of repeating visits is generated from.
///
/// Occurrences are REAL job rows, materialised over a rolling horizon rather
/// than computed on read. That is the decision the whole phase rests on:
/// because each visit is an ordinary job, assigning a crew to one, completing
/// one, or moving one to Thursday is just editing a job. The alternative —
/// virtual occurrences — needs a parallel exception table and a second set of
/// permission rules to get wrong.
model JobSeries {
  id String @id @default(uuid()) @db.Uuid

  organizationId String @map("organization_id") @db.Uuid

  /// The template every occurrence is stamped from.
  title       String
  description String?

  locationId String? @map("location_id") @db.Uuid
  customerId String? @map("customer_id") @db.Uuid

  addressLine1 String? @map("address_line1")
  addressLine2 String? @map("address_line2")
  city         String?
  region       String?
  postalCode   String? @map("postal_code")
  country      String?

  /// How long each visit runs. Stored as a duration rather than an end time,
  /// because the end moves with the start when a series is rescheduled.
  durationMinutes Int @map("duration_minutes")

  frequency RecurrenceFrequency
  /// Every N periods. 2 with WEEKLY is fortnightly, which is the single most
  /// common lawn-care cadence.
  interval  Int                 @default(1)

  /// Days of the week for a WEEKLY series, 0 = Sunday. Empty for other
  /// frequencies. A crew that comes Monday and Thursday is one series.
  byWeekday Int[] @map("by_weekday")

  /// The first date the series can produce, as a calendar day in the branch's
  /// timezone.
  startsOn DateTime @map("starts_on") @db.Date

  /// Minutes past local midnight. Stored as wall-clock rather than an instant
  /// because "9am every Tuesday" stays 9am across a daylight-saving change,
  /// which a fixed offset would not.
  startMinutes Int @map("start_minutes")

  /// Last date the series can produce. Null runs indefinitely.
  until DateTime? @db.Date

  /// Stopping a series leaves the visits already booked alone. A customer who
  /// cancels their contract in March does not un-happen February.
  active Boolean @default(true)

  createdByMembershipId String? @map("created_by_membership_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     Location?               @relation(fields: [locationId], references: [id], onDelete: SetNull)
  customer     Customer?               @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdBy    OrganizationMembership? @relation("SeriesCreator", fields: [createdByMembershipId], references: [id], onDelete: SetNull)

  jobs        Job[]
  assignments JobSeriesAssignment[]

  @@index([organizationId, active])
  @@index([customerId])
  @@map("job_series")
}

/// The default crew for a series. Copied onto each occurrence as it is made.
model JobSeriesAssignment {
  seriesId     String @map("series_id") @db.Uuid
  membershipId String @map("membership_id") @db.Uuid

  organizationId String @map("organization_id") @db.Uuid

  series JobSeries              @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  member OrganizationMembership @relation("SeriesAssignee", fields: [membershipId], references: [id], onDelete: Cascade)

  @@id([seriesId, membershipId])
  @@index([organizationId])
  @@map("job_series_assignments")
}

// ---------------------------------------------------------------------------
// Events and notifications (Phase 11)
// ---------------------------------------------------------------------------

/// Something that happened, recorded in the same transaction that caused it.
///
/// A transactional outbox, not an in-memory emitter. If the process dies
/// between "task assigned" and "email sent", an emitter loses the event and
/// nobody ever learns they were given work. Writing the event alongside the
/// change means the two commit together or not at all.
///
/// This is also the stream Phase 12's automation engine consumes, so its
/// durability is not only about email.
model DomainEvent {
  id String @id @default(uuid()) @db.Uuid

  organizationId String @map("organization_id") @db.Uuid

  /// Dotted and stable, e.g. `task.assigned`. Matched by handlers and, later,
  /// by automation triggers, so renaming one is a migration.
  type    String
  payload Json

  /// Null until handled. The dispatcher's whole query is "oldest unprocessed".
  processedAt DateTime? @map("processed_at")
  attempts    Int       @default(0)
  lastError   String?   @map("last_error")

  createdAt DateTime @default(now()) @map("created_at")

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@index([processedAt, createdAt])
  @@index([organizationId, type, createdAt])
  @@map("domain_events")
}

/// Something a particular person should know about.
///
/// Addressed to a membership rather than a user: the same person in two
/// organizations gets two separate inboxes, and leaving one company takes its
/// notifications with it.
model Notification {
  id String @id @default(uuid()) @db.Uuid

  organizationId String @map("organization_id") @db.Uuid
  membershipId   String @map("membership_id") @db.Uuid

  type  String
  title String
  body  String

  /// Where it points in the app. Relative, so it survives a domain change.
  linkPath String? @map("link_path")

  readAt DateTime? @map("read_at")

  /// Which event produced it, and when it went out by email.
  ///
  /// The unique pair below is what makes redelivery safe: a handler that fails
  /// halfway is retried, and the notification it already created is refused
  /// rather than duplicated. `emailedAt` does the same job for the email.
  eventId   String?   @map("event_id") @db.Uuid
  emailedAt DateTime? @map("emailed_at")

  createdAt DateTime @default(now()) @map("created_at")

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  member       OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  event        DomainEvent?           @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@unique([eventId, membershipId])
  @@index([membershipId, readAt, createdAt])
  @@index([organizationId])
  @@map("notifications")
}

/// Per-person, per-type delivery choices.
///
/// Absence means the default, which is on. Storing only the exceptions keeps
/// this table small and means a new notification type does not need a
/// backfill for every member of every organization.
model NotificationPreference {
  membershipId String @map("membership_id") @db.Uuid
  type         String

  organizationId String @map("organization_id") @db.Uuid

  inApp Boolean @default(true) @map("in_app")
  email Boolean @default(true)

  member OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@id([membershipId, type])
  @@index([organizationId])
  @@map("notification_preferences")
}

// ---------------------------------------------------------------------------
// Staff console (Phase 19a)
// ---------------------------------------------------------------------------

/// The people who run RelaStack, as opposed to its customers.
///
/// Granted only with SQL, as the owner role. The application role can read its
/// own row and nothing else, and cannot write here at all: no code path, bug
/// or compromised session can make someone staff.
model PlatformStaff {
  userId    String   @id @map("user_id") @db.Uuid
  note      String?
  grantedAt DateTime @default(now()) @map("granted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("platform_staff")
}

/// Every look and every action a staff member takes inside a business.
///
/// Append-only: the application role has no UPDATE or DELETE on it. Deliberately
/// no foreign keys, so the record survives the staff account or the business
/// being deleted; the email is stored for the same reason.
model StaffAuditEvent {
  id             String   @id @default(uuid()) @db.Uuid
  staffUserId    String   @map("staff_user_id") @db.Uuid
  staffEmail     String   @map("staff_email")
  organizationId String?  @map("organization_id") @db.Uuid
  action         String
  reason         String?
  details        Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organizationId, createdAt])
  @@index([createdAt])
  @@map("staff_audit_events")
}

/// Internal notes about a business. Never visible to the business itself.
model StaffNote {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  authorUserId   String   @map("author_user_id") @db.Uuid
  authorEmail    String   @map("author_email")
  body           String
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("staff_notes")
}

// ---------------------------------------------------------------------------
// Billing by hand (Phase 19b)
// ---------------------------------------------------------------------------

enum BillingInterval {
  MONTHLY
  ANNUAL

  @@map("billing_interval")
}

enum PaymentMethod {
  CARD
  BANK_TRANSFER
  CHECK
  CASH
  /// Nothing was paid: a founder's demo account, a research participant.
  COMPLIMENTARY
  OTHER

  @@map("payment_method")
}

/// Money received from a business, recorded by staff.
///
/// Until Phase 18 connects a payment provider, this is what makes a business
/// "paying". A payment covers a stretch of time; the subscription is paid
/// through the latest one.
///
/// Never edited and never deleted. A mistake is VOIDED, which the application
/// role can do exactly once and to nothing else: it holds UPDATE on the void
/// columns only, and only while the payment is unvoided.
model BillingPayment {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  /// Money received. Zero for a complimentary period.
  amountCents        Int @map("amount_cents")
  /// Credit the business had with us, spent on this period.
  creditAppliedCents Int @default(0) @map("credit_applied_cents")

  method    PaymentMethod
  interval  BillingInterval
  /// The plan paid for, at the time.
  planKey   String          @map("plan_key")
  /// Check number, transfer id: whatever finds it in the bank statement.
  reference String?

  paidAt      DateTime @map("paid_at")
  coversFrom  DateTime @map("covers_from")
  coversUntil DateTime @map("covers_until")

  recordedByUserId String  @map("recorded_by_user_id") @db.Uuid
  recordedByEmail  String  @map("recorded_by_email")
  note             String?

  voidedAt       DateTime? @map("voided_at")
  voidedByUserId String?   @map("voided_by_user_id") @db.Uuid
  voidedByEmail  String?   @map("voided_by_email")
  voidReason     String?   @map("void_reason")

  createdAt DateTime @default(now()) @map("created_at")

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  credits      BillingCredit[]

  @@index([organizationId, coversUntil])
  @@index([paidAt])
  @@map("billing_payments")
}

enum CreditKind {
  /// Given by staff: an outage, a goodwill gesture, a refund kept as credit.
  GRANTED
  /// Spent on a payment.
  APPLIED
  /// The payment it was spent on was voided, so it comes back.
  RESTORED
  /// Taken back by staff.
  REMOVED

  @@map("credit_kind")
}

/// Dollar credit a business holds with us, as a ledger.
///
/// The balance is the sum and is never stored, so it cannot drift from the
/// entries that explain it. Append-only, like the audit trail.
model BillingCredit {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  kind           CreditKind
  /// Positive adds to the balance, negative spends or removes it.
  amountCents    Int        @map("amount_cents")
  reason         String
  paymentId      String?    @map("payment_id") @db.Uuid
  staffUserId    String     @map("staff_user_id") @db.Uuid
  staffEmail     String     @map("staff_email")
  createdAt      DateTime   @default(now()) @map("created_at")

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payment      BillingPayment? @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("billing_credits")
}

// ---------------------------------------------------------------------------
// Help desk (Phase 19c)
// ---------------------------------------------------------------------------

enum SupportKind {
  QUESTION
  PROBLEM
  IDEA

  @@map("support_kind")
}

enum SupportStatus {
  /// Waiting on us.
  OPEN
  /// We replied and asked something; waiting on them.
  WAITING_ON_CUSTOMER
  RESOLVED

  @@map("support_status")
}

/// A question, problem or idea a business sends us from inside the app.
///
/// Row-level security keeps each business to its own; within a business the
/// service shows a request only to whoever opened it and to owners.
model SupportRequest {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  /// Kept as well as the id, so the request survives the person being removed.
  openedByUserId String @map("opened_by_user_id") @db.Uuid
  openedByEmail  String @map("opened_by_email")

  kind       SupportKind
  subject    String
  status     SupportStatus @default(OPEN)
  resolvedAt DateTime?     @map("resolved_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messages     SupportMessage[]

  @@index([organizationId, createdAt])
  @@index([status, updatedAt])
  @@map("support_requests")
}

/// One message in a help request. Append-only: nobody edits or deletes one.
model SupportMessage {
  id             String @id @default(uuid()) @db.Uuid
  requestId      String @map("request_id") @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  authorUserId String  @map("author_user_id") @db.Uuid
  authorEmail  String  @map("author_email")
  /// Written by RelaStack staff rather than the business.
  fromStaff    Boolean @map("from_staff")
  body         String

  createdAt DateTime @default(now()) @map("created_at")

  request SupportRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
  @@map("support_messages")
}

// ---------------------------------------------------------------------------
// Employee groups
// ---------------------------------------------------------------------------

/// A label a business gives its people: "Field crew", "Office", "Accounting".
///
/// Grants nothing. Roles decide what someone may do and locations where; a
/// group only helps find and organise people. Each business names its own.
model MemberGroup {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  name      String
  /// One of a fixed palette (see GROUP_COLORS in @platform/shared).
  color     String
  sortOrder Int    @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      MemberGroupMember[]

  @@index([organizationId])
  @@map("member_groups")
}

/// Who is in which group. Removed with either the group or the person.
model MemberGroupMember {
  groupId        String @map("group_id") @db.Uuid
  membershipId   String @map("membership_id") @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  group      MemberGroup            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  membership OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@id([groupId, membershipId])
  @@index([organizationId])
  @@index([membershipId])
  @@map("member_group_members")
}
