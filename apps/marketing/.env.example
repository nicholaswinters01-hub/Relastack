# Relastack marketing site — configuration
#
# Copy to .env.local for local development, and set the same keys in whatever
# hosts the site. None of these are needed to run it: with an empty file the
# form works end to end and writes signups to the server log.

# The public origin. Used to make Open Graph image URLs absolute, which they
# have to be -- a crawler fetching the social card has no page-relative
# context. Read on the server only, so deliberately NOT prefixed NEXT_PUBLIC.
# Leave unset locally.
SITE_URL=https://relastack.com

# Where signups go.
#   postgres    a database you own (recommended) -- set DATABASE_URL below
#   log         write to the server log (default; no account needed)
#   buttondown  sends its own confirmation, double opt-in for free
#   convertkit  sends its own confirmation
#   resend      does NOT send a confirmation; single opt-in unless you build it
WAITLIST_PROVIDER=postgres

# Postgres connection string, for the postgres provider. Neon gives one free.
DATABASE_URL=

# Secret. Server-side only — never prefix this NEXT_PUBLIC, or it ships to the
# browser and anyone can read your list.
WAITLIST_API_KEY=

# ConvertKit form id, or Resend audience id. Buttondown does not need it.
WAITLIST_LIST_ID=

# Sign-in for /admin. Generate both with:
#   node apps/marketing/scripts/admin-setup.mjs
# Leave unset and nobody can sign in; the rest of the site is unaffected.
ADMIN_USERS=
ADMIN_SESSION_SECRET=
