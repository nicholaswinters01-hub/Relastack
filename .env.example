# ---------------------------------------------------------------------------
# Copy this file to `.env` and adjust. `.env` is git-ignored and must never be
# committed. Every variable here is validated at startup by @platform/config —
# a missing or malformed value fails the process immediately rather than
# surfacing as a confusing runtime error later.
# ---------------------------------------------------------------------------

# Runtime environment: development | test | production
NODE_ENV=development

# --- Database --------------------------------------------------------------
# Matches the credentials in docker-compose.yml for local development.
DATABASE_URL=postgresql://platform:platform_dev_password@localhost:5432/platform_dev?schema=public

# Application connection — UNPRIVILEGED, and subject to every row-level
# security policy. This is what serves requests.
#
# It MUST be a different role from DATABASE_URL. That role is a superuser, and
# PostgreSQL exempts superusers from row-level security unconditionally — so
# running the app as it would leave every policy in place and enforcing
# nothing. Config refuses to start in production if these match.
#
# The role is created by the enable_row_level_security migration.
DATABASE_URL_APP=postgresql://platform_app:platform_app_dev_password@localhost:5432/platform_dev?schema=public

# --- API server ------------------------------------------------------------
API_PORT=4000
API_HOST=0.0.0.0

# Comma-separated list of origins permitted to call the API with credentials.
CORS_ORIGINS=http://localhost:3000

# Log verbosity: fatal | error | warn | info | debug | trace
LOG_LEVEL=debug

# --- Sessions --------------------------------------------------------------
# How long a session stays valid without renewal. Sessions past half their
# lifetime are extended automatically on use.
SESSION_TTL_DAYS=7

# Restricts the session cookie to HTTPS. MUST be true in production — config
# refuses to start otherwise. False locally so plain-HTTP development works.
COOKIE_SECURE=false

# Cookie domain. Leave unset for host-only cookies, which is the safer default.
# COOKIE_DOMAIN=

# --- Rate limiting ---------------------------------------------------------
# Master switch. MUST be true in production — config refuses to start
# otherwise. An unthrottled login endpoint is both a credential-stuffing
# target and, because Argon2 is deliberately expensive, a DoS vector.
RATE_LIMIT_ENABLED=true

# Per IP.
RATE_LIMIT_GLOBAL_PER_MINUTE=120
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_REGISTER_PER_HOUR=10

# --- Account lockout -------------------------------------------------------
# Consecutive failed sign-ins before an account is locked. Distinct from rate
# limiting, which counts per IP and is therefore defeated by an attacker
# rotating addresses — the shape credential stuffing actually takes.
LOGIN_MAX_FAILED_ATTEMPTS=8

# How long a lock lasts, in minutes. Deliberately temporary: a permanent lock
# would let anyone who knows an email address keep that user out indefinitely.
LOGIN_LOCKOUT_MINUTES=15

# --- Background work -------------------------------------------------------
# How often the sweeps and the fallback notification drain run, in seconds.
# New notifications go out within seconds regardless. Long on purpose: a
# database that sleeps when idle (Neon) only sleeps if nothing wakes it.
# 0 switches all background delivery off.
# DISPATCH_INTERVAL_SECONDS=3600

# --- Production only ---------------------------------------------------------
# Shared with the web tier. When set, the API answers nothing that does not
# carry it. Required in production; leave unset locally.
# INTERNAL_API_SECRET=

# Required to register a new business, when set. Production must set this or
# SIGNUP_OPEN=true. Invitations never need it.
# SIGNUP_ACCESS_CODE=
# SIGNUP_OPEN=false

# Lets a business choose a plan and simulate payments itself, which marks it
# as paying with no money involved. On by default locally, always off in
# production (the API refuses to start with it on), where staff record
# payments instead. Set false locally to see what production customers see.
# BILLING_SIMULATION=false

# Emailed whenever a business opens a help request.
# SUPPORT_NOTIFY_EMAIL=hello@relastack.com

# --- Web application -------------------------------------------------------
# Read by the web tier's server only; neither reaches the browser. Set both on
# the web tier's host in production (INTERNAL_API_SECRET matching the API's).
API_URL=http://localhost:4000
