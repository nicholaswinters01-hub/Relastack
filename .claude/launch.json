{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "marketing",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev:marketing"],
      "port": 3001
    },
    {
      "name": "app",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev"],
      "port": 3000,
      "env": {
        "RATE_LIMIT_GLOBAL_PER_MINUTE": "300"
      }
    },
    {
      "name": "app-hand-billed",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev"],
      "env": {
        "BILLING_SIMULATION": "false",
        "RATE_LIMIT_GLOBAL_PER_MINUTE": "300"
      },
      "port": 3000
    }
  ]
}
